generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ambiente {
  id_ambiente        Int             @id
  desc_ambiente      String          @unique @db.VarChar(50)
  fecha_creacion     DateTime        @default(now()) @db.Timestamptz(6)
  ip_creacion        String?         @db.VarChar(45)
  fecha_modificacion DateTime?       @db.Timestamptz(6)
  ip_modificacion    String?         @db.VarChar(45)
  base_de_datos      base_de_datos[]
  servidor           servidor[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model aplicacion {
  id                   Int                    @id @default(autoincrement())
  id_app               String                 @unique @db.VarChar(12)
  ambito               String?                @db.VarChar(30)
  abreviatura_app      String?                @db.VarChar(80)
  nombre_app           String?                @db.VarChar(250)
  desc_app             String?
  nombre_esquema_bd    Json?
  estado_app           String?                @db.VarChar(40)
  nombre_lider_usuario String?
  cargo_lider_usuario  String?
  area_usuaria_resp    String?
  unidad_jerarquica    String?
  gestor_resp          String?
  criticidad           String?                @db.VarChar(20)
  fecha_creacion       DateTime               @default(now()) @db.Timestamptz(6)
  ip_creacion          String?                @db.VarChar(45)
  fecha_modificacion   DateTime?              @db.Timestamptz(6)
  ip_modificacion      String?                @db.VarChar(45)
  observaciones        String?
  aplicacion_basedatos aplicacion_basedatos[]
  aplicacion_proceso   aplicacion_proceso[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model aplicacion_basedatos {
  id_aplicacion      Int
  id_bd              Int
  fecha_creacion     DateTime      @default(now()) @db.Timestamptz(6)
  ip_creacion        String?       @db.VarChar(45)
  fecha_modificacion DateTime?     @db.Timestamptz(6)
  ip_modificacion    String?       @db.VarChar(45)
  aplicacion         aplicacion           @relation(fields: [id_aplicacion], references: [id], onDelete: NoAction, onUpdate: NoAction)
  base_de_datos      base_de_datos        @relation(fields: [id_bd], references: [id_bd], onDelete: NoAction, onUpdate: NoAction)
  esquema_aplicacion esquema_aplicacion[]

  @@id([id_aplicacion, id_bd])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model aplicacion_proceso {
  id_aplicacion      Int
  id_proceso         Int
  fecha_creacion     DateTime        @default(now()) @db.Timestamptz(6)
  ip_creacion        String?         @db.VarChar(45)
  fecha_modificacion DateTime?       @db.Timestamptz(6)
  ip_modificacion    String?         @db.VarChar(45)
  origen             String?         @db.VarChar(10)
  aplicacion         aplicacion      @relation(fields: [id_aplicacion], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proceso_negocio    proceso_negocio @relation(fields: [id_proceso], references: [id_proceso], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_aplicacion, id_proceso])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model base_de_datos {
  id_bd                                                    Int                    @id @default(autoincrement())
  nombre_bd                                                String                 @db.VarChar(160)
  id_servidor                                              Int?
  id_ambiente                                              Int?
  id_motor_bd                                              Int?
  version_bd                                               String?                @db.VarChar(60)
  desc_base_datos                                          String?
  tipo_bd                                                  String?                @db.VarChar(80)
  tipo_info_gest                                           String?
  area_usuario_resp_onp                                    String?
  area_tecnica_resp_onp                                    String?
  tamano_gb                                                Decimal?               @db.Decimal(14, 2)
  nro_esquemas                                             Int?
  nro_tablas                                               Int?
  crecimiento_gb                                           Decimal?               @db.Decimal(14, 2)
  estado_bd                                                String?
  gestor                                                   String?
  resp_funcional                                           String?
  fecha_creacion                                           DateTime               @default(now()) @db.Timestamptz(6)
  ip_creacion                                              String?                @db.VarChar(45)
  fecha_modificacion                                       DateTime?              @db.Timestamptz(6)
  ip_modificacion                                          String?                @db.VarChar(45)
  observaciones                                            String?
  aplicacion_basedatos                                     aplicacion_basedatos[]
  esquema                                                  esquema[]
  ambiente                                                 ambiente?              @relation(fields: [id_ambiente], references: [id_ambiente], onDelete: NoAction, onUpdate: NoAction)
  motor_bd                                                 motor_bd?              @relation(fields: [id_motor_bd], references: [id_motor_bd], onDelete: NoAction, onUpdate: NoAction)
  servidor                                                 servidor?              @relation(fields: [id_servidor], references: [id_servidor], onDelete: NoAction, onUpdate: NoAction)
  integraciones_integraciones_id_bd_destinoTobase_de_datos integraciones[]        @relation("integraciones_id_bd_destinoTobase_de_datos")
  integraciones_integraciones_id_bd_origenTobase_de_datos  integraciones[]        @relation("integraciones_id_bd_origenTobase_de_datos")
}

model dominio_funcional {
  id_dominio         Int               @id
  id_tipo_proceso    Int
  desc_dominio       String            @db.VarChar(120)
  fecha_creacion     DateTime          @default(now()) @db.Timestamptz(6)
  ip_creacion        String?           @db.VarChar(45)
  fecha_modificacion DateTime?         @db.Timestamptz(6)
  ip_modificacion    String?           @db.VarChar(45)
  tipo_proceso       tipo_proceso      @relation(fields: [id_tipo_proceso], references: [id_tipo_proceso], onDelete: NoAction, onUpdate: NoAction)
  proceso_negocio    proceso_negocio[]

  @@unique([id_tipo_proceso, desc_dominio])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model integraciones {
  id_integracion                                           Int            @id @default(autoincrement())
  id_bd_origen                                             Int?
  origen_externo                                           String?        @db.VarChar(160)
  id_bd_destino                                            Int?
  destino_externo                                          String?        @db.VarChar(160)
  mecanismo                                                String?        @db.VarChar(120)
  nombre_enlace                                            String?        @db.VarChar(200)
  estado_enlace                                            String?        @db.VarChar(40)
  fecha_creacion                                           DateTime       @default(now()) @db.Timestamptz(6)
  ip_creacion                                              String?        @db.VarChar(45)
  fecha_modificacion                                       DateTime?      @db.Timestamptz(6)
  ip_modificacion                                          String?        @db.VarChar(45)
  base_de_datos_integraciones_id_bd_destinoTobase_de_datos base_de_datos? @relation("integraciones_id_bd_destinoTobase_de_datos", fields: [id_bd_destino], references: [id_bd], onDelete: NoAction, onUpdate: NoAction)
  base_de_datos_integraciones_id_bd_origenTobase_de_datos  base_de_datos? @relation("integraciones_id_bd_origenTobase_de_datos", fields: [id_bd_origen], references: [id_bd], onDelete: NoAction, onUpdate: NoAction)
  integracion_datastage                                    integracion_datastage?
  integracion_dblink                                       integracion_dblink?
}

model integracion_dblink {
  id_integracion              Int           @id
  owner                       String?       @db.VarChar(128)
  es_publico                  Boolean?      @default(false)
  usuario_remoto              String?       @db.VarChar(128)
  id_usuario_remoto           Int?
  host_destino                String?       @db.VarChar(512)
  usuario_remoto_privilegiado Boolean?
  nivel_riesgo                String?       @db.VarChar(20)
  fec_creacion_link           DateTime?     @db.Date
  fec_extraccion              DateTime      @default(now()) @db.Timestamptz(6)
  integraciones               integraciones @relation(fields: [id_integracion], references: [id_integracion], onDelete: Cascade, onUpdate: NoAction)
}

model integracion_datastage {
  id_integracion         Int           @id
  objetivo               String?
  aplicativo_modelo      String?       @db.VarChar(160)
  reprocesable           String?       @db.VarChar(5)
  proveedor              String?       @db.VarChar(120)
  responsable            String?       @db.VarChar(160)
  fec_ultima_modif       DateTime?     @db.Date
  version_job            String?       @db.VarChar(40)
  carpeta                String?       @db.VarChar(300)
  proyecto_ds            String?       @db.VarChar(80)
  servidor_ds            String?       @db.VarChar(80)
  param_conexion_origen  String?       @db.VarChar(300)
  param_conexion_destino String?       @db.VarChar(300)
  modo_carga             String?       @db.VarChar(160)
  tabla_origen           String?
  tabla_destino          String?
  usa_archivo_plano      Boolean?      @default(false)
  sql_extraccion         String?
  fecha_creacion         DateTime      @default(now()) @db.Timestamptz(6)
  ip_creacion            String?       @db.VarChar(45)
  fecha_modificacion     DateTime?     @db.Timestamptz(6)
  ip_modificacion        String?       @db.VarChar(45)
  integraciones          integraciones @relation(fields: [id_integracion], references: [id_integracion], onDelete: Cascade, onUpdate: NoAction)
}

model fuentes_institucionales {
  id_fuente                  String    @id @db.VarChar(12)
  fuente_documental          String?   @db.VarChar(300)
  descripcion_proposito      String?
  resumen                    String?
  area_responsable           String?   @db.VarChar(200)
  fecha_version_estado       String?   @db.VarChar(120)
  tipo_fuente                String?   @db.VarChar(120)
  formato_medio              String?   @db.VarChar(120)
  nivel_confidencialidad     String?   @db.VarChar(60)
  relacion_sistemas_procesos String?
  sirve_adi                  String?
  hallazgos                  String?
  vacios_inconsistencias     String?
  ubicacion_ruta             String?
  evidencia_revision         String?
  enlace                     String?
  origen_fuente              String?   @default("ADI-01") @db.VarChar(40)
  fecha_creacion             DateTime  @default(now()) @db.Timestamptz(6)
  ip_creacion                String?   @db.VarChar(45)
  fecha_modificacion         DateTime? @db.Timestamptz(6)
  ip_modificacion            String?   @db.VarChar(45)
}

model motor_bd {
  id_motor_bd        Int             @id
  desc_motor         String          @unique @db.VarChar(60)
  fecha_creacion     DateTime        @default(now()) @db.Timestamptz(6)
  ip_creacion        String?         @db.VarChar(45)
  fecha_modificacion DateTime?       @db.Timestamptz(6)
  ip_modificacion    String?         @db.VarChar(45)
  base_de_datos      base_de_datos[]
  servidor           servidor[]
}

model proceso_negocio {
  id_proceso         Int                  @id
  id_dominio         Int
  desc_proceso       String               @db.VarChar(160)
  fecha_creacion     DateTime             @default(now()) @db.Timestamptz(6)
  ip_creacion        String?              @db.VarChar(45)
  fecha_modificacion DateTime?            @db.Timestamptz(6)
  ip_modificacion    String?              @db.VarChar(45)
  aplicacion_proceso aplicacion_proceso[]
  dominio_funcional  dominio_funcional    @relation(fields: [id_dominio], references: [id_dominio], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model servidor {
  id_servidor            Int             @id @default(autoincrement())
  nombre_servidor        String          @unique @db.VarChar(120)
  fabricante_servidor    String?         @db.VarChar(120)
  nombre_so              String?         @db.VarChar(60)
  version_so             String?         @db.VarChar(60)
  tipo_servidor          String?         @db.VarChar(60)
  id_ambiente            Int?
  id_motor_bd            Int?
  fec_operacion_servidor DateTime?       @db.Date
  fec_fin_soporte_bd     DateTime?       @db.Date
  comentario             String?
  nro_cores              Int?
  memoria_gb             Int?
  disco_asignado_gb      Decimal?        @db.Decimal(14, 2)
  disco_utilizado_gb     Decimal?        @db.Decimal(14, 2)
  porc_uso_cpu_prom      Decimal?        @db.Decimal(5, 2)
  porc_uso_mem_prom      Decimal?        @db.Decimal(5, 2)
  pico_uso_cpu_1anio     Decimal?        @db.Decimal(5, 2)
  ubicacion              String?         @db.VarChar(120)
  responsable_tecnico    String?         @db.VarChar(160)
  fecha_creacion         DateTime        @default(now()) @db.Timestamptz(6)
  ip_creacion            String?         @db.VarChar(45)
  fecha_modificacion     DateTime?       @db.Timestamptz(6)
  ip_modificacion        String?         @db.VarChar(45)
  base_de_datos          base_de_datos[]
  ambiente               ambiente?       @relation(fields: [id_ambiente], references: [id_ambiente], onDelete: NoAction, onUpdate: NoAction)
  motor_bd               motor_bd?       @relation(fields: [id_motor_bd], references: [id_motor_bd], onDelete: NoAction, onUpdate: NoAction)
}

model tipo_proceso {
  id_tipo_proceso    Int                 @id
  desc_tipo_proceso  String              @unique @db.VarChar(60)
  fecha_creacion     DateTime            @default(now()) @db.Timestamptz(6)
  ip_creacion        String?             @db.VarChar(45)
  fecha_modificacion DateTime?           @db.Timestamptz(6)
  ip_modificacion    String?             @db.VarChar(45)
  dominio_funcional  dominio_funcional[]
}

// Maestro de esquemas fisicos (1 por BD+owner), poblado del catalogo Oracle.
model esquema {
  id_esquema         Int                  @id @default(autoincrement())
  id_bd              Int
  nombre_esquema     String               @db.VarChar(160)
  fecha_creacion     DateTime             @default(now()) @db.Timestamptz(6)
  ip_creacion        String?              @db.VarChar(45)
  fecha_modificacion DateTime?            @db.Timestamptz(6)
  ip_modificacion    String?              @db.VarChar(45)
  base_de_datos      base_de_datos        @relation(fields: [id_bd], references: [id_bd], onDelete: NoAction, onUpdate: NoAction)
  tabla              tabla[]
  esquema_aplicacion esquema_aplicacion[]

  @@unique([id_bd, nombre_esquema])
}

// Junction app <-> esquema fisico (antes era la tabla 'esquema', app-scoped).
model esquema_aplicacion {
  id_esquema_aplicacion Int                  @id @default(autoincrement())
  id_aplicacion         Int
  id_bd                 Int
  id_esquema            Int
  fecha_creacion        DateTime             @default(now()) @db.Timestamptz(6)
  ip_creacion           String?              @db.VarChar(45)
  fecha_modificacion    DateTime?            @db.Timestamptz(6)
  ip_modificacion       String?              @db.VarChar(45)
  aplicacion_basedatos  aplicacion_basedatos @relation(fields: [id_aplicacion, id_bd], references: [id_aplicacion, id_bd], onDelete: NoAction, onUpdate: NoAction)
  esquema               esquema              @relation(fields: [id_esquema], references: [id_esquema], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_aplicacion, id_esquema])
}

// Tabla fisica (hija de esquema)
model tabla {
  id_tabla           Int       @id @default(autoincrement())
  id_esquema         Int
  nombre_tabla       String    @db.VarChar(200)
  fecha_creacion     DateTime  @default(now()) @db.Timestamptz(6)
  ip_creacion        String?   @db.VarChar(45)
  fecha_modificacion DateTime? @db.Timestamptz(6)
  ip_modificacion    String?   @db.VarChar(45)
  esquema            esquema   @relation(fields: [id_esquema], references: [id_esquema], onDelete: NoAction, onUpdate: NoAction)
  columna            columna[]

  @@unique([id_esquema, nombre_tabla])
}

// Columna fisica (hija de tabla)
model columna {
  id_columna         Int       @id @default(autoincrement())
  id_tabla           Int
  col_id             Int?
  nombre_columna     String    @db.VarChar(200)
  tipo               String?   @db.VarChar(60)
  longitud           String?   @db.VarChar(40)
  nullable           String?   @db.VarChar(4)
  es_pk              String?   @db.VarChar(4)
  comentario         String?
  fecha_creacion     DateTime  @default(now()) @db.Timestamptz(6)
  ip_creacion        String?   @db.VarChar(45)
  fecha_modificacion DateTime? @db.Timestamptz(6)
  ip_modificacion    String?   @db.VarChar(45)
  tabla              tabla     @relation(fields: [id_tabla], references: [id_tabla], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_tabla, nombre_columna])
}

model oficina {
  sigla          String    @id @db.VarChar(20)
  nombre_vigente String    @db.VarChar(180)
  tipo_unidad    String?   @db.VarChar(60)
  sigla_padre    String?   @db.VarChar(20)
  fecha_creacion DateTime  @default(now()) @db.Timestamptz(6)
  padre          oficina?  @relation("jerarquia_oficina", fields: [sigla_padre], references: [sigla], onDelete: NoAction, onUpdate: NoAction)
  hijos          oficina[] @relation("jerarquia_oficina")
}
